   "source": [
    "import pandas as pd\n",
    "import re\n",
    "\n",
    "# 파일 불러오기\n",
    "cinema = pd.read_csv(\"../data/play/cinema.csv\")\n",
    "pc = pd.read_csv(\"../data/play/pc.csv\")\n",
    "sing = pd.read_csv(\"../data/play/sing.csv\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "28427378",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 주제 추가\n",
    "cinema['category'] = '영화관'\n",
    "pc['category'] = 'PC방'\n",
    "sing['category'] = '노래방'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "c56e2965",
   "metadata": {},
   "outputs": [],
   "source": [
    "# 통합\n",
    "play_df = pd.concat([cinema, pc, sing], ignore_index=True)"
   ]
  },
