    "# 우편번호 정제\n",
    "def clean_postal_code(x):\n",
    "    if pd.isna(x):\n",
    "        return pd.NA\n",
    "    digits = re.sub(r'[^0-9]', '', str(x))\n",
    "    return digits.zfill(5) if len(digits) == 5 else pd.NA"
   ]
  },
