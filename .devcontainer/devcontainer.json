{
  "name": "final-project-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "settings": {
    "terminal.integrated.defaultProfile.linux": "bash"
  },
  "extensions": [
    "ms-python.python",
    "ms-azuretools.vscode-docker"
  ],
  "forwardPorts": [8000, 5432, 8080],
  "remoteUser": "root",
  "postCreateCommand": "pip install -r requirements.txt"
}